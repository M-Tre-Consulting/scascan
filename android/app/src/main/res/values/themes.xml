<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ScaScan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colors will be automatically set by DynamicColors.applyToActivityIfAvailable -->
        <!-- and these provide the fallback if DynamicColors are not available -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">?attr/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">?attr/colorOnPrimaryContainer</item>
        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="colorOnSecondary">?attr/colorOnSecondary</item>
        <item name="colorSecondaryContainer">?attr/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSecondaryContainer</item>
        <item name="colorTertiary">?attr/colorTertiary</item>
        <item name="colorOnTertiary">?attr/colorOnTertiary</item>
        <item name="colorTertiaryContainer">?attr/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">?attr/colorOnTertiaryContainer</item>
        <item name="colorError">?attr/colorError</item>
        <item name="colorOnError">?attr/colorOnError</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorSurfaceVariant">?attr/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">?attr/colorOnSurfaceVariant</item>
        <item name="colorOutline">?attr/colorOutline</item>
        <item name="colorOutlineVariant">?attr/colorOutlineVariant</item>

        <!-- M3 Expressive shape system: everything is a pill or near-pill -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Pill</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Pill</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeRounded</item>

        <!-- Button override: full pill -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>

        <!-- FAB: pill shape -->
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.App.ExtendedFab</item>

        <!-- Card: large radius -->
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
    </style>

    <!-- Full pill shape (buttons, chips, FABs, search bars) -->
    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Large rounded (cards, bottom sheets) -->
    <style name="ShapeAppearance.App.LargeRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Option card shape (home screen) -->
    <style name="ShapeAppearance.App.OptionCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Icon container shape (squircle) -->
    <style name="ShapeAppearance.App.IconContainer" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Floating pill top bar -->
    <style name="ShapeAppearance.App.PillBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- FABs -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Large.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="Widget.App.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <!-- Cards -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeRounded</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Icon container card (squircle) -->
    <style name="Widget.App.IconContainer" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.App.IconContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Floating pill navigation bar -->
    <style name="Widget.App.PillBar" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.App.PillBar</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Indicator.Pill" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

</resources>
