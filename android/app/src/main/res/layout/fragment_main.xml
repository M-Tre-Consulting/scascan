<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/analysisProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        style="@style/Widget.App.PillBar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/customNav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:gravity="center"
            android:animateLayoutChanges="true">

            <!-- Home — the active item expands into a filled, labeled capsule; inactive
                 items stay icon-only. Mirrors Material 3's expressive nav-bar item shape. -->
            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/nav_pill_selector"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="@string/nav_scan"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/tvNavHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/nav_scan"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Log -->
            <LinearLayout
                android:id="@+id/btnNavLog"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/nav_pill_selector"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivNavLog"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_log"
                    android:contentDescription="@string/nav_log"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/tvNavLogLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/nav_log"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/btnNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/nav_pill_selector"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivNavProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@string/nav_profile"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/tvNavProfileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/nav_profile"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
